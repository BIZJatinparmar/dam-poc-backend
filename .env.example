DATABASE_URL=postgresql+psycopg://atlas:atlas@127.0.0.1:5432/atlas
ATLAS_DATA_DIR=./data
ATLAS_STORAGE_BACKEND=local
ATLAS_ALLOWED_ORIGINS=http://127.0.0.1:5173
# Azure App Service: ATLAS_STORAGE_BACKEND=blob
# ATLAS_BLOB_ACCOUNT_URL=https://<storage-account>.blob.core.windows.net
# ATLAS_BLOB_CONTAINER=assets
# Video transcription requires an Azure Speech resource and a separate private Blob container.
# ATLAS_SPEECH_AUDIO_CONTAINER=speech-audio
# ATLAS_SPEECH_ENDPOINT=https://<speech-resource>.cognitiveservices.azure.com
# ATLAS_SPEECH_KEY=<speech-resource-key>
# ATLAS_SPEECH_LOCALE=en-US
# ATLAS_FOUNDRY_ENDPOINT=https://<foundry-resource>.openai.azure.com
# ATLAS_FOUNDRY_KEY=<foundry-resource-key>
# ATLAS_FOUNDRY_DEPLOYMENT=gpt-5.4-nano
# Image tagging uses Content Understanding on a Foundry resource.
# ATLAS_CU_ENDPOINT=https://<foundry-resource>.services.ai.azure.com
# ATLAS_CU_KEY=<foundry-resource-key>
# ATLAS_CU_ANALYZER_ID=atlas_image_tags
# DATABASE_URL=postgresql+psycopg://<user>:<password>@<server>.postgres.database.azure.com:5432/atlas?sslmode=require
